# Copy to keystore.properties (git ignores it) to sign release builds.
# Create the keystore once, and keep it and its passwords safe: every update to the app must be
# signed with the same key, or Android won't install it over the old version.
#   keytool -genkeypair -v -keystore release.jks -alias release -keyalg RSA -keysize 4096 -validity 10000
storeFile=release.jks
storePassword=
keyAlias=release
keyPassword=

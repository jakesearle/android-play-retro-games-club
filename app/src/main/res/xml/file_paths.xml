<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Raw-path ROM folders, for {file.uri} emulators: internal storage (/storage/emulated/0,
         which /sdcard resolves to) and SD cards (/storage/XXXX-XXXX). Only /storage, so the
         provider can never hand out the app's own private files. -->
    <root-path name="storage" path="storage/" />
    <!-- Bug reports, shared through the share sheet (BugReport). -->
    <cache-path name="reports" path="reports/" />
</paths>
